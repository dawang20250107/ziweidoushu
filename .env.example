# ── 服务 ────────────────────────────────────────────────────────
# 监听地址
LISTEN_ADDR=:8080
# 常规接口超时(秒)
REQUEST_TIMEOUT_SECONDS=15
# 优雅停机等待(秒)
SHUTDOWN_TIMEOUT_SECONDS=20

# ── 并发与防护 ──────────────────────────────────────────────────
# 单 IP 每秒请求配额(<=0 关闭限流)
RATE_LIMIT_RPS=20
# 单 IP 突发配额
RATE_LIMIT_BURST=40
# 命盘结果 LRU 缓存条数
CHART_CACHE_SIZE=4096
# 跨域来源(逗号分隔,* 表示全部)
CORS_ALLOW_ORIGINS=*

# ── AI 解读(不配置任何 Key 则自动降级为知识库规则版解读)──────
# 供应商:anthropic | openai | off | 留空自动探测(anthropic 优先)
AI_PROVIDER=
# Anthropic 原生协议
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
# OpenAI 兼容协议(DeepSeek/通义/智谱/Moonshot 等改 BASE_URL 与 MODEL 即可)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# 上游并发上限 / 单次调用超时(秒) / 最大生成 tokens
AI_MAX_CONCURRENCY=8
AI_TIMEOUT_SECONDS=120
AI_MAX_TOKENS=2048

# ── 用户体系(可选:两项都配置才启用;否则无库模式,仅用户功能不可用)──
# PostgreSQL 连接串,启动时自动应用 migrations/
DATABASE_URL=
# 访问令牌签名密钥(≥32 字节);轮换期用 JWT_SECRET_PREV 兼容旧令牌
JWT_SECRET=
JWT_SECRET_PREV=
# dev 短信通道回显验证码(仅本地/E2E,生产必须为空)
SMS_DEV_ECHO_CODE=
# dev 支付渠道:模拟支付回调即时履约(仅本地/E2E,生产必须为空)
PAY_DEV_ENABLED=

# ── 内测鉴权(邮箱为主凭证;时刻推演一律北京时间,与部署时区无关)────
# 邀请码闸门:1=注册须携带有效邀请码(默认);公测置 0 撤闸
AUTH_INVITE_REQUIRED=1
# 环境检测:1=陌生设备密码登录须邮箱验证码升级(默认关)
AUTH_DEVICE_STRICT=
# SMTP 邮件通道(邮箱验证码):Host 留空走 dev 通道(验证码写日志)。
# 465=隐式 TLS / 587=STARTTLS;企业邮箱/阿里云邮件推送/腾讯云 SES 通用
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# 发件人展示,如 观星台 <noreply@example.com>(留空取 SMTP_USERNAME)
SMTP_FROM=

# ── 古籍语料 ────────────────────────────────────────────────────
# 外部古籍目录(后期投放古籍资料/倪师著作 JSON;支持热加载)
CORPUS_EXTERNAL_DIR=
# 管理接口令牌(语料热加载 + 邀请码铸造 /api/v1/admin/invites;留空则禁用)
ADMIN_TOKEN=
