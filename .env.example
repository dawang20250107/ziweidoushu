# ── 服务 ────────────────────────────────────────────────────────
# 监听地址
LISTEN_ADDR=:8080
# 常规接口超时(秒)
REQUEST_TIMEOUT_SECONDS=15
# 优雅停机等待(秒)
SHUTDOWN_TIMEOUT_SECONDS=20

# ── 并发与防护 ──────────────────────────────────────────────────
# 单 IP 每秒请求配额(<=0 关闭限流)
RATE_LIMIT_RPS=20
# 单 IP 突发配额
RATE_LIMIT_BURST=40
# 命盘结果 LRU 缓存条数
CHART_CACHE_SIZE=4096
# 跨域来源(逗号分隔,* 表示全部)
CORS_ALLOW_ORIGINS=*

# ── AI 解读(不配置任何 Key 则自动降级为知识库规则版解读)──────
# 供应商:anthropic | openai | off | 留空自动探测(anthropic 优先)
AI_PROVIDER=
# Anthropic 原生协议
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
# OpenAI 兼容协议(DeepSeek/通义/智谱/Moonshot 等改 BASE_URL 与 MODEL 即可)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# 上游并发上限 / 单次调用超时(秒) / 最大生成 tokens
AI_MAX_CONCURRENCY=8
AI_TIMEOUT_SECONDS=120
AI_MAX_TOKENS=2048

# ── 古籍语料 ────────────────────────────────────────────────────
# 外部古籍目录(后期投放古籍资料/倪师著作 JSON;支持热加载)
CORPUS_EXTERNAL_DIR=
# 管理接口令牌(POST /api/v1/admin/corpus/reload 用;留空则禁用)
ADMIN_TOKEN=
